<?xml version="1.0" encoding="utf-8"?>
<!--
  The Microsoft Store package of CompCue Link. Identity and Publisher are the values Partner Center gave this app;
  the Store signs the package, so nothing here needs a certificate of ours. __VERSION__ is filled in by the build.
  runFullTrust: this is a classic desktop program (it reads the League client's lockfile and talks to it on 127.0.0.1).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">
  <Identity Name="AndrsLince.CompCueLink" Publisher="CN=C0C79070-CFDD-40D9-8E94-882E2FE66BC3" Version="__VERSION__" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>CompCue Link</DisplayName>
    <PublisherDisplayName>Andrés Lince</PublisherDisplayName>
    <Logo>assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="es" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
  <Applications>
    <Application Id="CompCueLink" Executable="CompCueLink.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="CompCue Link" Description="Connects your League of Legends client to CompCue. Read-only."
        BackgroundColor="transparent" Square150x150Logo="assets\Square150x150Logo.png" Square44x44Logo="assets\Square44x44Logo.png" />
      <Extensions>
        <!-- the site's "Connect this PC" button: compcue-link:setup?key=... -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="compcue-link">
            <uap:DisplayName>CompCue Link</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
        <!-- starts with Windows; the player switches it off in Settings, Apps, Startup -->
        <desktop:Extension Category="windows.startupTask" Executable="CompCueLink.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="CompCueLinkStartup" Enabled="true" DisplayName="CompCue Link" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
